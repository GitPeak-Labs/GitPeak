{
  "name": "gitpeak",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && NODE_OPTIONS=--disable-warning=DEP0205 svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && NODE_OPTIONS=--disable-warning=DEP0205 svelte-check --tsconfig ./tsconfig.json --watch",
    "check:native": "node_modules/typescript-native/bin/tsc --noEmit -p tsconfig.native.json",
    "test": "bun test",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "fonts:download": "bun scripts/download-server-fonts.ts",
    "nuke": "bun run format && bun run lint && bun run check && bun run check:native && bun run test && bun run build"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.7.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.3.14",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-svelte": "^3.15.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.4.0",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.54.0",
    "svelte-check": "^4.7.3",
    "svelte-sonner": "^1.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:typescript@6.0.3",
    "typescript-eslint": "^8.60.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/svelte-query": "^6.1.36",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "chart.js": "^4.5.1",
    "lucide-svelte": "^1.0.1",
    "vanilla-colorful": "^0.7.2",
    "zod": "^4.4.3"
  }
}
